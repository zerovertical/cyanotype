{
  "name": "cyanotype-android",
  "version": "1.3.0",
  "private": true,
  "description": "Cyanotype: serverless peer-to-peer chat. The web app lives in web/; the Android wrapper keeps it running while the phone is locked and adds native notifications and file saving.",
  "scripts": {
    "sync": "cap sync android",
    "add:android": "cap add android",
    "signing-key": "node tools/make-signing-key.mjs",
    "test": "node tests/app.test.mjs && node tests/security.test.mjs",
    "test:security": "node tests/security.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "node-forge": "^1.4.3",
    "playwright-core": "^1.65.1"
  }
}
