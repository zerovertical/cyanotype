<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone in a backup or a phone-to-phone transfer.

  The app's storage holds the identity key, every pairing secret and the
  device key that encrypts messages at rest. A backup would copy all of it
  off the phone, together, so the encryption at rest would protect nothing.

  allowBackup="false" stops cloud backup. From Android 12 the device-to-device
  transfer is governed by these rules instead, so both are excluded here.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
